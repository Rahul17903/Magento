<?xml version="1.0"?>

<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <preference
        for="Codilar\ProductEnquiry\Api\Data\ProductEnquiryInterface"
        type="Codilar\ProductEnquiry\Model\ProductEnquiry"/>

    <preference
        for="Codilar\ProductEnquiry\Api\ProductEnquiryRepositoryInterface"
        type="Codilar\ProductEnquiry\Model\ProductEnquiryRepository"/>

    <type name="Codilar\ProductEnquiry\Logger\Handler">
        <arguments>
            <argument name="filesystem" xsi:type="object">
                Magento\Framework\Filesystem\Driver\File
            </argument>
        </arguments>
    </type>

    <type name="Codilar\ProductEnquiry\Logger\Logger">
        <arguments>
            <argument name="name" xsi:type="string">
                codilar_product_enquiry
            </argument>
            <argument name="handlers" xsi:type="array">
                <item name="system" xsi:type="object">
                    Codilar\ProductEnquiry\Logger\Handler
                </item>
            </argument>
        </arguments>
    </type>

</config>
