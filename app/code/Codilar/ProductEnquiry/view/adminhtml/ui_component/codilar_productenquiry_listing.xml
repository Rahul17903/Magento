<?xml version="1.0"?>

<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">

    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">
                codilar_productenquiry_listing.codilar_productenquiry_listing_data_source
            </item>
        </item>
    </argument>

    <settings>
        <buttons>
            <button name="add">
                <url path="productenquiry/productenquiry/new"/>
                <class>primary</class>
                <label translate="true">Add Enquiry</label>
            </button>
        </buttons>
        <spinner>codilar_productenquiry_columns</spinner>

        <deps>
            <dep>
                codilar_productenquiry_listing.codilar_productenquiry_listing_data_source
            </dep>
        </deps>
    </settings>

    <dataSource
        name="codilar_productenquiry_listing_data_source"
        component="Magento_Ui/js/grid/provider"
    >
        <settings>
            <updateUrl path="mui/index/render"/>

            <storageConfig>
                <param name="indexField" xsi:type="string">
                    entity_id
                </param>
            </storageConfig>
        </settings>

        <aclResource>Codilar_ProductEnquiry::product_enquiry</aclResource>

        <dataProvider
            class="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider"
            name="codilar_productenquiry_listing_data_source"
        >
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>entity_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>

    <listingToolbar name="listing_top">
        <settings>
            <sticky>true</sticky>
        </settings>

<!--        <bookmark name="bookmarks"/>-->

        <columnsControls name="columns_controls"/>

        <filters name="listing_filters"/>

        <massaction name="listing_massaction">
            <action name="delete">
                <settings>
                    <type>delete</type>
                    <label translate="true">
                        Delete
                    </label>
                    <url path="productenquiry/productenquiry/massDelete"/>
                    <confirm>
                        <title translate="true">
                            Delete Enquiries
                        </title>
                        <message translate="true">
                            Are you sure you want to delete the selected enquiries?
                        </message>
                    </confirm>
                </settings>
            </action>
            <action name="test">
                <settings>
                    <type>test1</type>
                    <label translate="true">
                        Test2
                    </label>
                    <url path="productenquiry/productenquiry/test"/>
                    <confirm>
                        <title translate="true">
                            Test Enquiries
                        </title>
                        <message translate="true">
                            Are you sure you want to Testign the selected enquiries?
                        </message>
                    </confirm>
                </settings>
            </action>
        </massaction>

        <paging name="listing_paging"/>
    </listingToolbar>

    <columns name="codilar_productenquiry_columns">

        <selectionsColumn name="ids" sortOrder="0">
            <settings>
                <indexField>entity_id</indexField>
            </settings>
        </selectionsColumn>

        <column name="entity_id" sortOrder="10">
            <settings>
                <filter>textRange</filter>
                <label translate="true">ID</label>
            </settings>
        </column>

        <column name="name" sortOrder="20">
            <settings>
                <filter>text</filter>
                <label translate="true">Customer Name</label>
            </settings>
        </column>

        <column name="email" sortOrder="30">
            <settings>
                <filter>text</filter>
                <label translate="true">Email</label>
            </settings>
        </column>

        <column name="address" sortOrder="40">
            <settings>
                <filter>text</filter>
                <label translate="true">Address</label>
            </settings>
        </column>

        <column name="sku" sortOrder="50">
            <settings>
                <filter>text</filter>
                <label translate="true">SKU</label>
            </settings>
        </column>

        <column name="qty" sortOrder="60">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Quantity</label>
            </settings>
        </column>

        <column name="created_at" sortOrder="70">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Submitted At</label>
            </settings>
        </column>

        <actionsColumn name="actions"
                       sortOrder="80"
                       class="Codilar\ProductEnquiry\Ui\Component\Listing\Column\Actions">
            <settings>
                <indexField>entity_id</indexField>
                <label translate="true">Action</label>
                <sortable>false</sortable>
                <filter>false</filter>
            </settings>
        </actionsColumn>

    </columns>

</listing>
