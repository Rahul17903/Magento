<?php

declare(strict_types=1);

/** @var \Codilar\ProductBadge\Block\Badge $block */
/** @var \Magento\Framework\Escaper $escaper */

$product = $block->getProduct();

if (!$product || !$product->getId()) {
    return;
}

$badge = $block->getBadge($product);

if (!$badge) {
    return;
}

$badgeClass = $block->getBadgeClass($badge);
?>

<span class="product-badge <?= $escaper->escapeHtmlAttr($badgeClass) ?>">
    <?= $escaper->escapeHtml(__($badge)) ?>
</span>
